# deyeconfig automatic mode: plans the battery from real PVPC prices, the solar
# forecast and the expected consumption, with storm and outage protection.
# It writes the plan to the inverter (--apply). Remove --apply from ExecStart to
# run it in dry run mode (it only logs the plan).
# Adjust User and the paths if you installed deyeconfig elsewhere, then:
#   sudo cp systemd/deye-optimizer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deye-optimizer.service
# Logs: journalctl -u deye-optimizer.service -f

[Unit]
Description=deyeconfig automatic mode (price optimizer with storm protection)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/deye
ExecStart=/home/ubuntu/deye/.venv/bin/python /home/ubuntu/deye/deye_optimizer.py --daemon --apply
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
